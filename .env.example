POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=worldbank

# Postgres as seen from inside the Docker network (used by the ClickHouse container).
POSTGRES_HOST=postgres

# Postgres as seen from your machine (used by ingestion). Different on purpose.
INGESTION_DB_HOST=localhost
INGESTION_DB_PORT=5433

CLICKHOUSE_USER=data_engineer
CLICKHOUSE_PASSWORD=changeme

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# Host port for the Dagster UI when running through Docker (default 3100).
# DAGSTER_PORT=3100

# UN Comtrade API
COMTRADE_API_KEY=some_random_api_key
